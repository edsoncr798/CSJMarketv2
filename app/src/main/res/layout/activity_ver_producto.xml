<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".VerProducto"
    android:fitsSystemWindows="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/vp_topbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="5dp">

        <ImageButton
            android:id="@+id/vp_btnRegresar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:padding="5dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_baseline_arrow_back_24" />
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/vp_topbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_margin="10dp">

                    <ImageView
                        android:id="@+id/vp_ImagenProducto"
                        android:layout_width="280dp"
                        android:layout_height="280dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/default_image" />

                    
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/seccionUnidades"
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <Button
                        android:id="@+id/vp_btnUnidad"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="120dp"
                        android:minHeight="48dp"
                        android:layout_marginRight="10dp"
                        android:background="@drawable/estilo_boton2"
                        android:elevation="5dp"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="Unidad"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/vp_btnPaquete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="120dp"
                        android:minHeight="48dp"
                        android:layout_marginLeft="10dp"
                        android:background="@drawable/estilo_boton1"
                        android:elevation="5dp"
                        android:foreground="?android:attr/selectableItemBackgroundBorderless"
                        android:paddingLeft="16dp"
                        android:paddingRight="16dp"
                        android:text="Pack"
                        android:textStyle="bold" />
                </LinearLayout>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardElevation="5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:paddingHorizontal="15dp"
                        android:paddingVertical="5dp">

                        <TextView
                            android:id="@+id/vp_nombreProducto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/roboto"
                            android:text="TextView"
                            android:textAlignment="center"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginTop="5dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:layout_marginBottom="5dp">

                            <TextView
                                android:id="@+id/vp_txtUnidad"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TextView"
                                android:textColor="@android:color/holo_red_dark"
                                android:textStyle="bold"
                                android:textAlignment="center"
                                android:textSize="18sp" />

                            <TextView
                                android:id="@+id/vp_txtPrecio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="5dp"
                                android:text="TextView"
                                android:textAlignment="center"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:visibility="gone"/>
                            <TextView
                                android:id="@+id/vp_cajaBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="8dp"
                                android:paddingLeft="8dp"
                                android:paddingRight="8dp"
                                android:paddingTop="2dp"
                                android:paddingBottom="2dp"
                                android:text="Mejor precio por caja"
                                android:textSize="11sp"
                                android:textColor="@android:color/white"
                                android:background="@drawable/bg_badge_bonus"
                                android:visibility="gone"/>
                        </LinearLayout>


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:padding="5dp"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="50dp"
                                android:layout_weight="2"
                                android:layout_gravity="center_vertical"
                                android:background="@drawable/borde_gris"
                                android:orientation="horizontal">

                                <Button
                                    android:id="@+id/vp_btnDisminuir"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:text="-"
                                    android:textColor="@color/black" />

                                <EditText
                                    android:id="@+id/vp_txtCantidad"
                                    android:layout_width="match_parent"
                                    android:layout_height="50dp"
                                    android:layout_weight="3"
                                    android:layout_gravity="center"
                                    android:inputType="number"
                                    android:text="1"
                                    android:textAlignment="center"/>

                                <Button
                                    android:id="@+id/vp_btnAumentar"
                                    android:layout_width="50dp"
                                    android:layout_height="50dp"
                                    android:background="?android:attr/selectableItemBackgroundBorderless"
                                    android:text="+"
                                    android:textColor="@color/black" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/estilo_boton1"
                                android:layout_weight="3">
                                <Button
                                    android:id="@+id/vp_btnComprar"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:layout_marginLeft="5dp"
                                    android:layout_marginRight="10dp"
                                    android:inputType="textCapWords"
                                    android:text="@string/agregar"
                                    android:textStyle="bold"
                                    android:background="@drawable/ripple"/>
                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/vp_cajaSavings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/holo_green_dark"
                            android:textAlignment="center"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"/>

                        <TextView
                            android:id="@+id/vp_txtStockDisponible"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Stock: 0"
                            android:textSize="14sp"
                            android:textColor="@android:color/darker_gray"
                            android:textAlignment="center"
                            android:layout_marginTop="8dp"/>

                        <TextView
                            android:id="@+id/vp_txtCodigoProducto"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Código: 0000"
                            android:textSize="14sp"
                            android:textColor="@android:color/darker_gray"
                            android:textAlignment="center"
                            android:layout_marginTop="4dp"/>

                        <!-- Sección de descuento: visible solo cuando hay descuento activo -->
                        <LinearLayout
                            android:id="@+id/vp_discountContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:background="@drawable/bg_bonus_container"
                            android:visibility="gone">

                            <LinearLayout
                                android:id="@+id/vp_discountLoader"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:padding="8dp"
                                android:visibility="gone">

                                <ProgressBar
                                    style="@android:style/Widget.ProgressBar.Small"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:indeterminate="true"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Cargando descuento..."
                                    android:textSize="13sp"
                                    android:textColor="@android:color/darker_gray"/>
                            </LinearLayout>

                            <!-- Título principal de descuento -->
                            <TextView
                                android:id="@+id/vp_discountTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="¡Descuento disponible!"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/holo_red_dark"/>

                            <!-- Contenedor de resumen visual del descuento -->
                            <androidx.cardview.widget.CardView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                app:cardBackgroundColor="#f8f9fa"
                                app:cardCornerRadius="8dp"
                                app:cardElevation="2dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <!-- Porcentaje real aplicado -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:gravity="center_vertical">

                                        <TextView
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:text="Descuento aplicado:"
                                            android:textSize="14sp"
                                            android:textColor="@android:color/darker_gray"/>

                                        <TextView
                                            android:id="@+id/vp_discountConditionType"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Por valor"
                                            android:textSize="11sp"
                                            android:textColor="@android:color/white"
                                            android:layout_marginEnd="4dp"
                                            android:padding="2dp"
                                            android:background="@drawable/bg_badge_bonus"/>

                                        <TextView
                                            android:id="@+id/vp_discountPercentLabel"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="0%"
                                            android:textSize="20sp"
                                            android:textStyle="bold"
                                            android:textColor="@android:color/holo_red_dark"
                                            android:background="@drawable/bg_discount_percent"
                                            android:padding="6dp"/>
                                    </LinearLayout>

                                    <!-- Monto actual vs monto con descuento -->
                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginTop="8dp"
                                        android:gravity="center_vertical">

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Subtotal:"
                                                android:textSize="12sp"
                                                android:textColor="@android:color/darker_gray"/>

                                            <TextView
                                                android:id="@+id/vp_discountSubtotal"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="S/ 0.00"
                                                android:textSize="16sp"
                                                android:textStyle="bold"
                                                android:textColor="@android:color/black"/>
                                        </LinearLayout>

                                        <ImageView
                                            android:layout_width="24dp"
                                            android:layout_height="24dp"
                                            android:src="@drawable/ic_arrow_forward"
                                            android:layout_marginHorizontal="8dp"
                                            android:tint="@android:color/darker_gray"/>

                                        <LinearLayout
                                            android:layout_width="0dp"
                                            android:layout_height="wrap_content"
                                            android:layout_weight="1"
                                            android:orientation="vertical">

                                            <TextView
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="Total con descuento:"
                                                android:textSize="12sp"
                                                android:textColor="@android:color/darker_gray"/>

                                            <TextView
                                                android:id="@+id/vp_discountTotal"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:text="S/ 0.00"
                                                android:textSize="18sp"
                                                android:textStyle="bold"
                                                android:textColor="@android:color/holo_green_dark"/>
                                        </LinearLayout>
                                    </LinearLayout>

                                    <!-- Barra de progreso visual -->
                                    <ProgressBar
                                        android:id="@+id/vp_discountProgress"
                                        style="?android:attr/progressBarStyleHorizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="6dp"
                                        android:layout_marginTop="8dp"
                                        android:progress="0"
                                        android:max="100"
                                        android:progressTint="@android:color/holo_green_dark"
                                        android:progressBackgroundTint="@color/light_gray"
                                        android:visibility="gone"/>
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Mensajes de descuento (reglas) -->
                            <TextView
                                android:id="@+id/vp_discountMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_green_dark"/>

                            <!-- Detalles de las reglas -->
                            <TextView
                                android:id="@+id/vp_discountDetail"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="13sp"
                                android:textColor="@android:color/darker_gray"/>

                            <!-- Ahorro dinámico -->
                            <TextView
                                android:id="@+id/vp_discountSavings"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text=""
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/holo_green_dark"
                                android:background="#e8f5e8"
                                android:padding="8dp"
                                android:gravity="center"/>

                            <!-- Fecha de validez -->
                            <TextView
                                android:id="@+id/vp_discountValidity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="@android:color/darker_gray"
                                android:gravity="center"/>
                        </LinearLayout>

                <!-- Sección de bonificación: visible solo cuando hay bonificación activa -->
                <LinearLayout
                    android:id="@+id/vp_bonusContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:padding="10dp"
                    android:background="@drawable/bg_bonus_container"
                    android:visibility="gone">

                            <!-- Loader mientras carga la bonificación -->
                            <LinearLayout
                                android:id="@+id/vp_bonusLoader"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:orientation="horizontal"
                                android:padding="8dp"
                                android:visibility="gone">

                                <ProgressBar
                                    style="@android:style/Widget.ProgressBar.Small"
                                    android:layout_width="24dp"
                                    android:layout_height="24dp"
                                    android:indeterminate="true"/>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:text="Cargando bonificación..."
                                    android:textSize="13sp"
                                    android:textColor="@android:color/darker_gray"/>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/vp_bonusTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="¡Bonificación disponible!"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/holo_orange_dark"/>

                            <TextView
                                android:id="@+id/vp_bonusMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text=""
                                android:textSize="14sp"
                                android:textColor="@android:color/holo_green_dark"/>

                            <TextView
                                android:id="@+id/vp_bonusRequirement"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="13sp"
                                android:textColor="@android:color/darker_gray"/>

                            <TextView
                                android:id="@+id/vp_bonusGift"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/holo_green_dark"/>

                            <ImageView
                                android:id="@+id/vp_bonusImage"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_marginTop="6dp"
                                android:layout_gravity="center_horizontal"
                                android:contentDescription="@string/app_name"
                                android:scaleType="centerCrop"
                                android:src="@drawable/default_image"
                                android:visibility="gone"/>

                            <TextView
                                android:id="@+id/vp_bonusDynamicCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="@android:color/holo_green_dark"/>

                            <TextView
                                android:id="@+id/vp_bonusStock"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="13sp"
                                android:textColor="@android:color/holo_green_dark"/>

                            <TextView
                                android:id="@+id/vp_bonusValidity"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="@android:color/darker_gray"/>

                            <TextView
                                android:id="@+id/vp_bonusNextHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text=""
                                android:textSize="12sp"
                                android:textColor="@android:color/holo_orange_dark"/>

                             <ProgressBar
                                 android:id="@+id/vp_bonusProgress"
                                 style="?android:attr/progressBarStyleHorizontal"
                                 android:layout_width="match_parent"
                                 android:layout_height="8dp"
                                 android:layout_marginTop="6dp"
                                 android:progress="0"
                                 android:max="100"
                                 android:progressTint="@android:color/holo_green_dark"
                                 android:progressBackgroundTint="@android:color/darker_gray"/>

                             <TextView
                                 android:id="@+id/vp_bonusSavings"
                                 android:layout_width="match_parent"
                                 android:layout_height="wrap_content"
                                 android:layout_marginTop="6dp"
                                 android:text=""
                                 android:textSize="13sp"
                                 android:textColor="@android:color/holo_green_dark"/>

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
